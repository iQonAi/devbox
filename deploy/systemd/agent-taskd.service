[Unit]
Description=agent-task orchestrator daemon (devbox)
Documentation=https://github.com/iQonAi/devbox
After=network-online.target
Wants=network-online.target

[Service]
# Long-running socket daemon: it signals readiness via sd_notify once the Unix
# socket is listening (implemented in M0). Until the M0 binary exists this unit
# is installed but NOT started.
Type=notify
User=agent-taskd
Group=agent-taskd
# agentwork is the shared group for the per-task scratch handoff (M5): the daemon
# creates work dirs the container uid (agentbox) reads/writes. Both users join it.
SupplementaryGroups=agentwork

# Binary produced by the M0 build (`go build -o /usr/local/bin/agent-task ./cmd/agent-task`).
# Not present until M0 — do not `systemctl start` before then.
ExecStart=/usr/local/bin/agent-task serve

# Unix socket (D2, no TCP). A rootless service cannot own a bare /run/agent-task.sock,
# so the socket lives in a systemd-managed runtime dir: /run/agent-task/agent-task.sock
# (0660, owner agent-taskd). Mode 0750 lets the agent-taskd group (which the operator
# joins) traverse the dir to reach the socket for the CLI.
RuntimeDirectory=agent-task
RuntimeDirectoryMode=0750

# SQLite DB + host worktrees / mirror cache: /var/lib/agent-task (daemon-only).
StateDirectory=agent-task
StateDirectoryMode=0700

# --- Secrets: systemd LoadCredential (root-owned 0600 source files) ---
# Each secret is delivered read-only into $CREDENTIALS_DIRECTORY, owned by the
# service user and unreadable by any other user (including agentbox, the
# container-runner uid). The service user has NO other path to these secrets.
# One repository-scoped, fine-grained machine-user token per registered repo
# (D11), named by the config `token_ref`. The machine user is `iQonAi-Bot`; its
# tokens are minted with the org `iQonAi` as resource owner (see the runbook).
# Deferred repos add one line each as they join the org; the per-agent model API
# key (M3) is wired the same way.
LoadCredential=gh-token-devbox:/etc/agent-task/credentials/gh-token-devbox
# Per-agent model credential (M5), named by the config agents.<name>.token_ref:
LoadCredential=claude-oauth-token:/etc/agent-task/credentials/claude-oauth-token
#LoadCredential=gh-token-claude-agent-config:/etc/agent-task/credentials/gh-token-claude-agent-config
#LoadCredential=gh-token-case-tracker-fc:/etc/agent-task/credentials/gh-token-case-tracker-fc

Restart=on-failure
RestartSec=2s

# --- Sandboxing: deliberately minimal, dictated by the cross-user Podman hop ---
# The daemon runs `sudo -u agentbox podman` in its OWN mount namespace, so any
# directive that isolates the namespace also breaks the container runner:
#   - ProtectHome=yes hides /home/agentbox, where agentbox's rootless podman
#     storage lives -> `podman create` fails (M5: this stuck a task in Running).
#   - PrivateTmp=yes gives podman a private /tmp, breaking its runtime state.
#   - NoNewPrivileges would block the sudo hop itself.
# These stay OFF until the runner's isolation mechanism is finalized (post-#17).
# The container — not the daemon unit — is the isolation boundary (0003).

[Install]
WantedBy=multi-user.target
